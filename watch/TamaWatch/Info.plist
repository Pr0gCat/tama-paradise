<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The extended runtime session that keeps the game in front (Awake in TamaWatchApp.swift). -->
	<key>WKBackgroundModes</key>
	<array>
		<string>mindfulness</string>
	</array>
	<!-- The dimmed Always On screen keeps showing the game. -->
	<key>WKSupportsAlwaysOnDisplay</key>
	<true/>
</dict>
</plist>
